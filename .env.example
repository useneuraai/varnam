# =====================================================================================
# VARNAM WEDDING PLATFORM - ENVIRONMENT CONFIGURATION
# Add these 4 keys to Vercel Project Settings -> Environment Variables
# =====================================================================================

# --- 1. SUPABASE (2 KEYS REQUIRED) ---
# Found at: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# --- 2. RAZORPAY (2 KEYS REQUIRED) ---
# Found at: Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_TpjNlkEUA7d6yp
RAZORPAY_KEY_SECRET=YIwSqeOt3mdiVFIFgkMo0TDl

