# =====================================================================================
# VARNAM WEDDING PLATFORM ENVIRONMENT VARIABLES
# Private keys as recommended by Vercel & Supabase
# Copy to `.env.local` for local development or paste into Vercel Project Settings
# =====================================================================================

# 1. Supabase Cloud Database Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Razorpay Payment Gateway (Test or Live Mode)
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3. Application Site URL (for OAuth redirect callbacks)
SITE_URL=http://localhost:3000
